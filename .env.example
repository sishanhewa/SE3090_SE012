# ===================================
# TalentFlow AI - Environment Variables
# SE3090_SE012
# ===================================
# Copy this file to .env and fill in real values
# NEVER commit the .env file to git

# ===================================
# Backend - ASP.NET Core
# ===================================
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=talentflow;Username=talentflow_user;Password=your_password_here

# JWT Configuration
Jwt__Key=your-256-bit-secret-key-minimum-32-characters-long
Jwt__Issuer=TalentFlowAPI
Jwt__Audience=TalentFlowClients
Jwt__ExpiryMinutes=15

# AI Service (internal)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-internal-api-key-here

# CORS
REACT_ORIGIN=http://localhost:5173

# ===================================
# Agentic AI Service - Python
# ===================================
GEMINI_API_KEY=your-gemini-api-key-here
BACKEND_INTERNAL_URL=http://localhost:5000
BACKEND_INTERNAL_API_KEY=your-internal-api-key-here

# ===================================
# External Services
# ===================================

# Google Calendar (Interview scheduling)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Cloudinary (Document/CV storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===================================
# React App
# ===================================
VITE_API_BASE_URL=http://localhost:5000/api

# ===================================
# Flutter App
# ===================================
# API_BASE_URL is configured in lib/core/api/dio_client.dart
